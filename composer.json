{
    "name": "justinholtweb/craft-stars",
    "description": "Review & testimonial management for Craft CMS — star ratings, moderation, schema.org markup, and spam protection.",
    "version": "5.0.3",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "reviews",
        "ratings",
        "testimonials",
        "schema.org"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.0.0",
        "codeception/module-asserts": "^3.0.0",
        "codeception/module-yii2": "^1.1.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\stars\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\stars\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "codecept run unit"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Stars",
        "handle": "stars",
        "hasCpSettings": true,
        "hasCpSection": true,
        "class": "justinholtweb\\stars\\Plugin"
    }
}
